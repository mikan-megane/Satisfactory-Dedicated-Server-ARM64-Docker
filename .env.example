# UID/GID that own ./satisfactory, ./config and ./fex-data.
# On Oracle Cloud's Ubuntu images the default user is usually 1001:1001.
# Run `id` on the host and put the numbers here.
PUID=1000
PGID=1000

# FEX build to install:
#   auto      best for the machine that builds the image (recommended)
#   armv8.0   any ARMv8.0+ CPU (Raspberry Pi 4, etc.)
#   armv8.2   Ampere Altra, AWS Graviton 2/3, Neoverse N1 (recommended for cloud)
#   armv8.4   newer Neoverse V2 / Graviton 3+ class CPUs
# The image must be built on the same class of CPU it runs on when using auto.
FEX_ARCH=auto

# Published ports (container side is 7777/tcp+udp and 8888/tcp).
# Keep these at 7777/8888. The server stores its settings in
# ServerSettings.<game port>.sav, so changing the game port makes it look like
# a brand-new server (unclaimed, no auto-load session) and clients have to
# re-add and re-claim it. Ports are published 1:1 on purpose; asymmetric
# mappings such as 17777:7777 break client connections.
SERVER_GAME_PORT=7777
SERVER_MESSAGING_PORT=8888

# Check Steam for a new server build on every container start.
ALWAYS_UPDATE_ON_START=true

# Install the experimental branch instead of the stable branch.
EXPERIMENTAL_BRANCH=false

# Extra arguments passed to FactoryServer.sh. Leave empty to use the default:
#   -log -unattended -ini:Engine:[HTTPServer.Listeners]:DefaultBindAddress=any
# EXTRA_PARAMS=-log -unattended -multihome=0.0.0.0
